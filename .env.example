# Copia este archivo como .env y reemplaza los valores de ejemplo.
# El archivo .env NO se sube a GitHub (está en .gitignore).

PORT=3000
NODE_ENV=development

# Administrador del panel. La contraseña NO va aquí: va su hash bcrypt.
# Genera el hash con: npm run admin:hash
ADMIN_USER=REEMPLAZA_CON_TU_USUARIO
ADMIN_PASSWORD_HASH=REEMPLAZA_CON_UN_HASH_BCRYPT

# Clave para firmar los tokens JWT (mínimo 32 caracteres, aleatoria).
JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Sitios que pueden usar la API (CORS).
FRONTEND_ORIGIN=https://michemango.netlify.app
GITHUB_PAGES_ORIGIN=https://lombanarafael.github.io
CORS_ORIGINS=https://michemango.netlify.app,https://lombanarafael.github.io

# Base de datos PostgreSQL de Neon. Vacía = usar SQLite local (solo en desarrollo).
DATABASE_URL=

# (Opcional) Dónde guardar el archivo SQLite local.
# SQLITE_PATH=src/data/michemango.sqlite
