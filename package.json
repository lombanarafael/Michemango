{
  "name": "michemango",
  "version": "1.0.0",
  "description": "MicheMango es una página web creada para promocionar y vender miche de mango. Su objetivo es ofrecer a los clientes una forma sencilla de conocer los productos, los precios y la información del emprendimiento.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:frontend": "vite --host 0.0.0.0",
    "build": "vite build",
    "db:init": "node src/scripts/iniciar-bd.js",
    "admin:hash": "node src/scripts/generar-hash.js",
    "catalogo:sync": "node src/scripts/generar-catalogo-respaldo.js",
    "catalogo:check": "node src/scripts/generar-catalogo-respaldo.js --check",
    "test:smoke": "node src/scripts/prueba-rapida.js",
    "check": "node src/scripts/revisar-sintaxis.js && npm run catalogo:check && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lombanarafael/Michemango.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lombanarafael/Michemango/issues"
  },
  "homepage": "https://github.com/lombanarafael/Michemango#readme",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
